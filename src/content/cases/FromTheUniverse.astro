// CLAUDE.md in the same repository; git history for dates. No user research yet: the case
// rests on the product thinking, and says so.
import CaseSection from "../../components/case/CaseSection.astro";
import Shot from "../../components/case/Shot.astro";
import Stats from "../../components/case/Stats.astro";
