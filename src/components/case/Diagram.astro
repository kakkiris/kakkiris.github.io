---
// A system diagram redrawn in the site's style: hairline boxes, Inter labels, the key path
// in the accent colour, steps done by people in dashed outline. Two layouts, wide for
// desktop and tall for phones. Lines draw once when the diagram enters view (case.ts).
import type { Diagram, Layout, Side, Point } from "../../data/diagrams";

interface Props {
  diagram: Diagram;
  n: number;
  caption: string;
}

const { diagram, n, caption } = Astro.props;
const NODE_H = 58;

function anchor(layout: Layout, id: string, side: Side, at = 0.5): Point {
  const b = layout.nodes[id];
  const h = b.h ?? NODE_H;
  if (side === "l") return [b.x, b.y + h * at];
  if (side === "r") return [b.x + b.w, b.y + h * at];
  if (side === "t") return [b.x + b.w * at, b.y];
  return [b.x + b.w * at, b.y + h];
}

function route(layout: Layout, e: Diagram["edges"][number]) {
  const spec = layout.edges?.[`${e.from}>${e.to}`];
  const fs = spec?.fs ?? e.fs;
  const ts = spec?.ts ?? e.ts;
  const p1 = anchor(layout, e.from, fs, spec?.fa);
  const p2 = anchor(layout, e.to, ts, spec?.ta);
  const pts: Point[] = [p1];
  if (spec?.via) pts.push(...spec.via);
  else {
    const horizontal = (s: Side) => s === "l" || s === "r";
    if (horizontal(fs) && horizontal(ts)) {
      if (Math.abs(p1[1] - p2[1]) > 0.5) {
        const mx = (p1[0] + p2[0]) / 2;
        pts.push([mx, p1[1]], [mx, p2[1]]);
      }
    } else if (!horizontal(fs) && !horizontal(ts)) {
      if (Math.abs(p1[0] - p2[0]) > 0.5) {
        const my = (p1[1] + p2[1]) / 2;
        pts.push([p1[0], my], [p2[0], my]);
      }
    } else if (horizontal(fs)) pts.push([p2[0], p1[1]]);
    else pts.push([p1[0], p2[1]]);
  }
  pts.push(p2);
  const d = pts.map((p, i) => `${i ? "L" : "M"}${p[0]} ${p[1]}`).join(" ");
  // Arrowhead along the last segment
  const [a, b] = [pts[pts.length - 2], p2];
  const ang = Math.atan2(b[1] - a[1], b[0] - a[0]);
  const s = 6;
  const left: Point = [b[0] - s * Math.cos(ang - 0.5), b[1] - s * Math.sin(ang - 0.5)];
  const right: Point = [b[0] - s * Math.cos(ang + 0.5), b[1] - s * Math.sin(ang + 0.5)];
  const head = `M${left[0].toFixed(1)} ${left[1].toFixed(1)} L${b[0]} ${b[1]} L${right[0].toFixed(1)} ${right[1].toFixed(1)}`;
  const mid = pts[Math.floor(pts.length / 2)];
  return { d, head, mid, p1, pts, noLabel: spec?.noLabel ?? false };
}

const nodeById = Object.fromEntries(diagram.nodes.map((nd) => [nd.id, nd]));
const variants = (["wide", "tall"] as const).map((key) => {
  const layout = diagram.layouts[key];
  return {
    key,
    layout,
    edges: diagram.edges.map((e) => ({ e, r: route(layout, e) })),
  };
});
const titleId = `diagram-${n}-title`;
const descId = `diagram-${n}-desc`;
---

<figure class="diagram wide" data-diagram data-reveal id={`figure-${n}`}>
  {
    variants.map(({ key, layout, edges }) => (
      <svg
        class={`d-${key}`}
        viewBox={`0 0 ${layout.w} ${layout.h}`}
        width={layout.w}
        height={layout.h}
        role="img"
        aria-labelledby={`${titleId} ${descId}`}
      >
        <title id={key === "wide" ? titleId : undefined}>{diagram.title}</title>
        <desc id={key === "wide" ? descId : undefined}>{diagram.description}</desc>
        {layout.lanes?.map((lane) => (
          <g class="lane">
            <line x1="0" x2={layout.w} y1={lane.y} y2={lane.y} />
            <text x="0" y={lane.y + 18}>
              {lane.label}
            </text>
          </g>
        ))}
        <g class="edges">
          {edges.map(({ e, r }) => (
            <g class:list={["edge", { key: e.key, soft: e.soft }]}>
              <path class="line" d={r.d} pathLength="1" />
              <path class="head" d={r.head} />
              {e.label && !r.noLabel && (
                <text class="edge-label" x={r.mid[0] + (e.labelDx ?? 6)} y={r.mid[1] + (e.labelDy ?? -6)}>
                  {e.label}
                </text>
              )}
            </g>
          ))}
        </g>
        <g class="nodes">
          {Object.entries(layout.nodes).map(([id, b]) => {
            const nd = nodeById[id];
            const h = b.h ?? NODE_H;
            const lines = nd.sub ?? [];
            const top = b.y + h / 2 - (lines.length * 15) / 2 + 2;
            return (
              <g class:list={["node", nd.kind, { key: nd.key }]}>
                <rect x={b.x} y={b.y} width={b.w} height={h} rx="4" />
                <text class="label" x={b.x + 12} y={top}>
                  {nd.label}
                </text>
                {lines.map((line, i) => (
                  <text class="sub" x={b.x + 12} y={top + 16 + i * 14}>
                    {line}
                  </text>
                ))}
              </g>
            );
          })}
        </g>
      </svg>
    ))
  }
  <figcaption>
    <p class="caption"><span class="caption-n">Figure {n}</span> {caption}</p>
    <p class="legend">
      <span class="key-swatch" aria-hidden="true"></span> Key path
      <span class="person-swatch" aria-hidden="true"></span> Done by a person
    </p>
    <p class="reconstructed">Reconstructed from planning documents</p>
  </figcaption>
</figure>

<style>
  .diagram {
    margin: 40px 0 48px -40px;
    width: calc(100% + 40px);
    max-width: none;
    padding: 24px 24px 16px;
    border: 1px solid var(--rule);
    border-radius: 3px;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--sans);
  }
  .d-tall {
    display: none;
  }
  .lane line {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .lane text {
    font-size: 11.5px;
    fill: var(--muted);
  }
  .node rect {
    fill: var(--paper);
    stroke: var(--muted);
    stroke-width: 1;
  }
  .node.key rect {
    stroke: var(--accent);
  }
  .node.person rect {
    stroke-dasharray: 4 3;
  }
  .node.store rect {
    stroke-width: 1.5;
  }
  .node.optional rect {
    stroke-dasharray: 2 3;
    stroke: var(--rule);
  }
  .node .label {
    font-size: 13px;
    font-weight: 500;
    fill: var(--ink);
  }
  .node .sub {
    font-size: 11px;
    fill: var(--muted);
  }
  .edge .line,
  .edge .head {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .edge.soft .line {
    stroke-dasharray: 3 3;
  }
  .edge.key .line,
  .edge.key .head {
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .edge-label {
    font-size: 11px;
    fill: var(--muted);
  }

  /* Lines draw once when the diagram enters view */
  :global(.js) .diagram .edge:not(.soft) .line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  :global(.js) .diagram .head,
  :global(.js) .diagram .edge-label {
    opacity: 0;
  }
  :global(.js) .diagram.is-drawn .edge:not(.soft) .line {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--t-layout) var(--ease);
  }
  :global(.js) .diagram.is-drawn .head,
  :global(.js) .diagram.is-drawn .edge-label {
    opacity: 1;
    transition: opacity var(--t-press) var(--ease) 380ms;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: baseline;
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-size: 13px;
    color: var(--muted);
  }
  .caption {
    flex: 1 1 320px;
    font-size: 14px;
  }
  .caption-n {
    color: var(--ink);
    font-weight: 500;
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .key-swatch,
  .person-swatch {
    display: inline-block;
    width: 18px;
    height: 0;
    border-top: 1.5px solid var(--accent);
  }
  .person-swatch {
    width: 14px;
    height: 10px;
    margin-left: 12px;
    border: 1px dashed var(--muted);
    border-radius: 2px;
  }
  .reconstructed {
    width: 100%;
    font-size: 12px;
  }

  @media (max-width: 720px) {
    .diagram {
      margin: 32px 0 40px;
      width: 100%;
      padding: 16px 12px 12px;
    }
    .d-wide {
      display: none;
    }
    .d-tall {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .diagram .edge:not(.soft) .line {
      stroke-dasharray: none !important;
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
    :global(.js) .diagram.is-drawn .head,
    :global(.js) .diagram.is-drawn .edge-label {
      transition: opacity 120ms linear;
    }
  }
</style>
