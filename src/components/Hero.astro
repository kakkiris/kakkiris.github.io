---
import { CV_URL, GITHUB_URL, LINKEDIN_URL } from "../data/site";
---

<section class="hero" data-hero-root>
  <p class="kicker" data-hero style="--d: 0ms">Product Manager · Monk AI Group · UCL</p>
  <h1 data-hero="split">
    I turn messy operational workflows into <span class="nowrap"><em>working software</em>,</span> from discovery call to clickable product in days.
  </h1>
  <p class="intro" data-hero data-hero-after="1">
    I run discovery with the teams doing the work, decide what is worth building, and build the prototype they can test before anyone commits budget.
  </p>
  <p class="links" data-hero data-hero-after="2">
    <a class="text-link" href={CV_URL} download="Kerem-Akkiris-CV.pdf">Download CV</a>
    <a class="text-link" href={GITHUB_URL}>GitHub</a>
    <a class="text-link" href={LINKEDIN_URL}>LinkedIn</a>
  </p>
</section>

<style>
  .hero {
    display: grid;
    gap: 24px;
    padding: 96px 0 72px;
  }
  .kicker {
    font-size: 14px;
    color: var(--muted);
    letter-spacing: 0.01em;
  }
  h1 {
    font: 400 clamp(2.25rem, 1.15rem + 4.4vw, 4.125rem) / 1.06 var(--serif);
    font-optical-sizing: auto;
    letter-spacing: -0.017em;
    max-width: 20ch;
    text-wrap: balance;
  }
  h1 em {
    font-style: italic;
    color: var(--accent);
  }
  .nowrap {
    white-space: nowrap;
  }
  .intro {
    max-width: 54ch;
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 15px;
  }

  /* Load sequence (src/scripts/hero.ts): the headline rises line by line, then the intro and links */
  :global(.js) [data-hero] {
    opacity: 0;
  }
  :global(.js) h1[data-hero] {
    opacity: 1;
    visibility: hidden;
  }
  :global(.js) .is-revealing h1[data-hero] {
    visibility: visible;
  }
  h1 :global(.word) {
    display: inline-block;
  }
  .is-revealing :global(.word),
  .is-revealing [data-hero]:not(h1) {
    animation: rise var(--t-small) var(--ease) both;
    animation-delay: var(--d, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .is-revealing :global(.word),
    .is-revealing [data-hero]:not(h1) {
      animation-name: fade;
      animation-delay: 0ms;
    }
  }
  @media (max-width: 720px) {
    .hero {
      gap: 20px;
      padding: 56px 0 48px;
    }
    .intro {
      font-size: 17px;
    }
  }
</style>

<script>
  import "../scripts/hero";
</script>
