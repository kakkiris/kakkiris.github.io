---
import { CASES, FEATURED } from "../data/cases";
import { LENSES, DEFAULT_LENS } from "../data/lenses";

const lens = LENSES.find((l) => l.id === DEFAULT_LENS)!;
// Every featured case is rendered once; the lens decides order and visibility.
const rows = [...lens.order, ...FEATURED.filter((slug) => !lens.order.includes(slug))].map((slug) => CASES[slug]);
const lensData = Object.fromEntries(LENSES.map((l) => [l.id, { order: l.order, note: l.note }]));
const teamforge = CASES.teamforge;
---

<section class="work" id="work" aria-labelledby="work-heading">
  <h2 id="work-heading" class="visually-hidden">Selected work</h2>
  <div class="lensbar" data-reveal>
    <div class="lens-row">
      <span class="lens-label" id="lens-label">Viewing as</span>
      <div class="lens" role="group" aria-labelledby="lens-label" data-lens-group>
        <span class="lens-indicator" aria-hidden="true" data-lens-indicator></span>
        {
          LENSES.map((l) => (
            <button type="button" data-lens={l.id} aria-pressed={String(l.id === DEFAULT_LENS)}>
              {l.label}
            </button>
          ))
        }
      </div>
    </div>
    <p class="lens-note" aria-live="polite" data-lens-note>{lens.note}</p>
  </div>

  <div class="cases-wrap" data-reveal>
    <ol class="cases" data-cases>
      {
        rows.map((c) => {
          const position = lens.order.indexOf(c.slug);
          return (
            <li class="case-row" data-case={c.slug} hidden={position === -1}>
              <span class="num" aria-hidden="true" data-num>
                {position === -1 ? "" : String(position + 1).padStart(2, "0")}
              </span>
              <div class="main">
                <p class="context">{c.context}</p>
                <h3 class="title" style={`view-transition-name: case-${c.slug}`}>
                  <a class="case-link" href={`/work/${c.slug}?lens=${DEFAULT_LENS}`} data-lens-link>
                    {c.title}
                  </a>
                </h3>
                <p class="summary">{c.summary}</p>
              </div>
              <p class="outcome">
                <span class="outcome-main">{c.outcome}</span>
                <span class="outcome-note">{c.outcomeNote}</span>
              </p>
            </li>
          );
        })
      }
    </ol>
    <div class="ghosts" aria-hidden="true" data-ghosts></div>
  </div>

  <p class="more" data-reveal>
    More work:{" "}
    <a class="text-link" href={`/work/teamforge?lens=${DEFAULT_LENS}`} data-lens-link>{teamforge.title}</a>, a contribution
    tracker for university group projects, built as Technical Lead.
  </p>
</section>

<script is:inline define:vars={{ lensData, defaultLens: DEFAULT_LENS }}>
  // Applies a lens without animation. Runs before first paint for ?lens= URLs, and is
  // reused by src/scripts/lens.ts inside its animated switch.
  (function () {
    var list = document.querySelector("[data-cases]");
    var group = document.querySelector("[data-lens-group]");
    var note = document.querySelector("[data-lens-note]");
    function apply(id) {
      var lens = lensData[id];
      if (!lens) return false;
      var rows = {};
      Array.prototype.forEach.call(list.children, function (li) {
        rows[li.getAttribute("data-case")] = li;
      });
      lens.order.forEach(function (slug, i) {
        var li = rows[slug];
        li.hidden = false;
        li.querySelector("[data-num]").textContent = (i < 9 ? "0" : "") + (i + 1);
        list.appendChild(li);
      });
      Object.keys(rows).forEach(function (slug) {
        if (lens.order.indexOf(slug) === -1) {
          rows[slug].hidden = true;
          list.appendChild(rows[slug]);
        }
      });
      group.querySelectorAll("button[data-lens]").forEach(function (b) {
        b.setAttribute("aria-pressed", String(b.getAttribute("data-lens") === id));
      });
      note.textContent = lens.note;
      document.querySelectorAll("[data-lens-link]").forEach(function (a) {
        var url = new URL(a.getAttribute("href"), location.href);
        url.searchParams.set("lens", id);
        a.setAttribute("href", url.pathname + url.search + url.hash);
      });
      document.documentElement.setAttribute("data-lens", id);
      return true;
    }
    window.__applyLens = apply;
    var requested = new URLSearchParams(location.search).get("lens");
    if (!(requested && requested !== defaultLens && apply(requested))) {
      document.documentElement.setAttribute("data-lens", defaultLens);
    }
  })();
</script>

<script>
  import "../scripts/lens";
</script>

<style>
  .lensbar {
    display: grid;
    gap: 8px;
    padding: 16px 0 20px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .lens-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
  }
  .lens-label {
    font-size: 13px;
    color: var(--muted);
  }
  .lens {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .lens button {
    position: relative;
    z-index: 1;
    padding: 6px 14px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    cursor: pointer;
    transition: color var(--t-press) var(--ease);
  }
  .lens button:hover,
  .lens button[aria-pressed="true"] {
    color: var(--ink);
  }
  .lens button:active {
    transform: translateY(1px);
  }
  /* Without the script, the pressed button carries its own outline */
  .lens:not(.has-indicator) button[aria-pressed="true"] {
    border-color: var(--ink);
  }
  .lens-indicator {
    position: absolute;
    top: 0;
    left: 0;
    border: 1px solid var(--ink);
    border-radius: 999px;
    opacity: 0;
    pointer-events: none;
  }
  .has-indicator .lens-indicator {
    opacity: 1;
  }
  .indicator-ready .lens-indicator {
    transition:
      transform var(--t-small) var(--ease),
      width var(--t-small) var(--ease),
      height var(--t-small) var(--ease);
  }
  .lens-note {
    font-size: 14px;
    color: var(--muted);
  }

  .cases-wrap {
    position: relative;
  }
  .cases {
    list-style: none;
    padding: 0;
  }
  .case-row {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 232px;
    gap: 32px;
    padding: 40px 0;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .num {
    padding-top: 6px;
    font: 400 16px/1.2 var(--serif);
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--muted);
  }
  .context {
    margin-bottom: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .title {
    font: 400 30px/1.15 var(--serif);
    font-optical-sizing: auto;
    letter-spacing: -0.008em;
    transition:
      transform var(--t-press) var(--ease),
      color var(--t-press) var(--ease);
  }
  .case-link {
    text-decoration: none;
  }
  /* The whole row is the link target */
  .case-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .case-link:focus-visible {
    outline: none;
  }
  .case-link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .summary {
    max-width: 52ch;
    margin-top: 12px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .outcome {
    display: grid;
    align-content: start;
    gap: 6px;
    padding-left: 24px;
    border-left: 1px solid var(--rule);
  }
  .outcome-main {
    font: 400 22px/1.25 var(--serif);
    font-optical-sizing: auto;
  }
  .outcome-note {
    font-size: 14px;
    color: var(--muted);
  }

  /* Hover: the title shifts and takes the accent, and an accent rule draws in under the row */
  .case-row::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-small) var(--ease);
  }
  .case-row:has(.case-link:focus-visible) .title {
    color: var(--accent);
  }
  @media (hover: hover) and (pointer: fine) {
    .case-row:hover .title {
      transform: translateX(4px);
      color: var(--accent);
    }
    .case-row:hover::after {
      transform: scaleX(1);
    }
  }

  .ghosts {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .ghosts > :global(*) {
    position: absolute;
    margin: 0;
  }

  .more {
    padding: 40px 0 96px;
    font-size: 15px;
    color: var(--muted);
  }
  .more a {
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .lensbar {
      padding: 16px 0;
    }
    .lens-label {
      flex-basis: 100%;
    }
    .lens {
      margin-left: -9px;
      gap: 0;
    }
    .lens button {
      padding: 6px 9px;
    }
    .case-row {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 16px 12px;
      padding: 32px 0;
    }
    .outcome {
      grid-column: 2;
      padding: 12px 0 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
    .title {
      font-size: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .indicator-ready .lens-indicator,
    .title,
    .case-row::after {
      transition: none;
    }
    .lens button:active {
      transform: none;
    }
    @media (hover: hover) and (pointer: fine) {
      .case-row:hover .title {
        transform: none;
      }
      .case-row::after {
        transform: scaleX(1);
        opacity: 0;
        transition: opacity 120ms linear;
      }
      .case-row:hover::after {
        opacity: 1;
      }
    }
  }
</style>
