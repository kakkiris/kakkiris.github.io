---
import BaseLayout from "./BaseLayout.astro";
import SectionIndex from "../components/case/SectionIndex.astro";
import { CASES, FEATURED, type CaseSlug } from "../data/cases";
import { LENSES, DEFAULT_LENS } from "../data/lenses";
import { SECTIONS } from "../data/sections";
import "../styles/case.css";

interface Props {
  slug: CaseSlug;
  /** Short pages: a few open sections, no index rail */
  short?: boolean;
}

const { slug, short = false } = Astro.props;
const c = CASES[slug];
const openByLens = Object.fromEntries(LENSES.map((l) => [l.id, l.openSections]));
const sectionNumbers = Object.fromEntries(SECTIONS.map((s) => [s.id, s.n]));
const orders = Object.fromEntries(LENSES.map((l) => [l.id, l.order]));
const titles = Object.fromEntries(FEATURED.map((s) => [s, CASES[s].title]));
const defaultOrder = orders[DEFAULT_LENS];
const nextSlug = defaultOrder[(defaultOrder.indexOf(slug) + 1) % defaultOrder.length] ?? defaultOrder[0];
---

<BaseLayout title={`${c.title}, Kerem Akkiris`} description={c.summary} ogImage={`/og/${c.slug}.png`}>
  <script is:inline slot="head" define:vars={{ openByLens, sectionNumbers, defaultLens: DEFAULT_LENS }}>
    // Which sections start open: the lens decides, and a #section link opens its own.
    (function () {
      var lens = new URLSearchParams(location.search).get("lens");
      var open = (openByLens[lens] || openByLens[defaultLens]).slice();
      var fromHash = sectionNumbers[location.hash.slice(1)];
      if (fromHash && open.indexOf(fromHash) === -1) open.push(fromHash);
      document.documentElement.setAttribute("data-open", open.join(" "));
    })();
  </script>

  <article class="wrap case">
    <header class="case-header">
      <a class="back text-link" href="/#work" data-lens-link>All work</a>
      <p class="case-context">{c.context}</p>
      <h1 style={`view-transition-name: case-${c.slug}`}>{c.title}</h1>
      <p class="case-summary">{c.summary}</p>
      {
        c.facts && (
          <dl class="facts">
            {c.facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.href ? <a class="text-link" href={f.href}>{f.value}</a> : f.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </header>

    <div class:list={["case-body", { short }]} data-case-body>
      {!short && <SectionIndex />}
      <slot />
    </div>

    <nav class="next" aria-label="Next case study">
      <p class="next-label">Next case study</p>
      <a class="next-link" href={`/work/${nextSlug}?lens=${DEFAULT_LENS}`} data-next data-lens-link>
        {titles[nextSlug]}
      </a>
    </nav>
  </article>

  <script is:inline define:vars={{ orders, titles, slug, defaultLens: DEFAULT_LENS }}>
    // The next case follows the reader's lens order.
    (function () {
      var lens = new URLSearchParams(location.search).get("lens");
      var order = orders[lens] || orders[defaultLens];
      var i = order.indexOf(slug);
      var next = order[(i + 1) % order.length];
      var link = document.querySelector("[data-next]");
      link.textContent = titles[next];
      link.setAttribute("href", "/work/" + next + "?lens=" + (orders[lens] ? lens : defaultLens));
    })();
  </script>
  <script>
    import "../scripts/case";
  </script>
</BaseLayout>

<style>
  .case-header {
    display: grid;
    gap: 16px;
    padding: 56px 0 56px;
  }
  .back {
    justify-self: start;
    margin-bottom: 24px;
    font-size: 14px;
    color: var(--muted);
  }
  .case-context {
    font-size: 14px;
    color: var(--muted);
  }
  h1 {
    max-width: 18ch;
    font: 400 clamp(2.5rem, 1.6rem + 3.6vw, 4rem) / 1.05 var(--serif);
    font-optical-sizing: auto;
    letter-spacing: -0.017em;
    text-wrap: balance;
  }
  .case-summary {
    max-width: 680px;
    margin-top: 8px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px 32px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }
  .facts dt {
    font-size: 13px;
    color: var(--muted);
  }
  .facts dd {
    margin: 4px 0 0;
    font-size: 15px;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .case-body {
    position: relative;
  }
  .next {
    display: grid;
    gap: 8px;
    padding: 56px 0 96px;
    border-top: 1px solid var(--rule);
  }
  .next-label {
    font-size: 14px;
    color: var(--muted);
  }
  .next-link {
    justify-self: start;
    font: 400 clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem) / 1.15 var(--serif);
    font-optical-sizing: auto;
    letter-spacing: -0.012em;
    text-decoration: none;
    transition:
      color var(--t-press) var(--ease),
      transform var(--t-press) var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .next-link:hover {
      color: var(--accent);
      transform: translateX(4px);
    }
  }
  @media (max-width: 900px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .case-header {
      padding: 32px 0 40px;
    }
    .back {
      margin-bottom: 16px;
    }
    .case-summary {
      font-size: 17px;
    }
    .facts {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .next-link:hover {
      transform: none;
    }
  }
</style>
