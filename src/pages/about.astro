---
// About. Facts from the CV; "How I work" draws only on decisions documented in the case studies.
import BaseLayout from "../layouts/BaseLayout.astro";
import { CV_URL, GITHUB_URL, LINKEDIN_URL } from "../data/site";

const principles = [
  {
    title: "Catch errors where they start",
    text: "Check the work at the moment it is submitted, not when it reaches payroll or the client.",
    cases: [{ slug: "cedar-peak", label: "Finance operations platform" }],
  },
  {
    title: "Every check explains itself",
    text: "A failure names the rule and the fix, and every field says where it came from and how sure the system is.",
    cases: [
      { slug: "cedar-peak", label: "Finance operations platform" },
      { slug: "ap-automation", label: "Accounts payable suite" },
      { slug: "flexops-ai", label: "FlexOps AI" },
    ],
  },
  {
    title: "Code does the arithmetic; the model only reads",
    text: "Money, matching and status rules stay in plain code. Models read documents and return fields that are checked.",
    cases: [{ slug: "ap-automation", label: "Accounts payable suite" }],
  },
  {
    title: "People keep the approvals",
    text: "Tools draft, flag and suggest. Payments, ROI figures and anything sent to a client are approved by a person.",
    cases: [
      { slug: "ap-automation", label: "Accounts payable suite" },
      { slug: "audit-os", label: "Audit OS" },
    ],
  },
  {
    title: "Show the work, not vanity numbers",
    text: "Build for the priority the client names, and let the screens show what happened rather than hours saved.",
    cases: [{ slug: "ap-automation", label: "Accounts payable suite" }],
  },
  {
    title: "Use the team's own words",
    text: "Screens and names follow the step as the team describes it, in plain language, with no system jargon.",
    cases: [
      { slug: "ap-automation", label: "Accounts payable suite" },
      { slug: "audit-os", label: "Audit OS" },
    ],
  },
  {
    title: "Build what changes the outcome",
    text: "The cheapest fix is not always the right build, and a smaller, reliable scope beats a long feature list.",
    cases: [
      { slug: "cedar-peak", label: "Finance operations platform" },
      { slug: "teamforge", label: "TeamForge" },
    ],
  },
];
---

<BaseLayout title="About, Kerem Akkiris" description="Kerem Akkiris is a product manager at Monk AI Group and a final-year student at UCL." ogImage="/og/about.png">
  <article class="wrap about">
    <header class="about-header">
      <h1>About</h1>
      <p class="lead">
        I am a product manager at Monk AI Group and a final-year student at UCL. I work where operations meet software:
        I turn what teams describe into specs, decide what is worth building, and build the prototype they can test.
      </p>
    </header>

    <section class="facts" aria-labelledby="facts-heading">
      <h2 id="facts-heading" class="visually-hidden">Education and experience</h2>
      <dl>
        <div>
          <dt>Monk AI Group</dt>
          <dd>Product Manager, since May 2025</dd>
        </div>
        <div>
          <dt>EY UK&amp;I Assurance</dt>
          <dd>Audit intern, July 2026</dd>
        </div>
        <div>
          <dt>UCL</dt>
          <dd>BSc Information Management for Business, graduating June 2027, First Class average</dd>
        </div>
      </dl>
      <p class="links">
        <a class="text-link" href={CV_URL} download="Kerem-Akkiris-CV.pdf">Download CV</a>
        <a class="text-link" href={GITHUB_URL}>GitHub</a>
        <a class="text-link" href={LINKEDIN_URL}>LinkedIn</a>
      </p>
    </section>

    <section class="how" aria-labelledby="how-heading">
      <h2 id="how-heading">How I work</h2>
      <p class="how-intro">Taken from decisions documented in the case studies.</p>
      <ul class="principles">
        {
          principles.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
              <p class="seen">
                {p.cases.map((c, i) => (
                  <>
                    {i > 0 && ", "}
                    <a class="text-link" href={`/work/${c.slug}`} data-lens-link>
                      {c.label}
                    </a>
                  </>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .about {
    padding-bottom: 96px;
  }
  .about-header {
    display: grid;
    gap: 24px;
    padding: 72px 0 48px;
  }
  h1 {
    font: 400 clamp(2.5rem, 1.6rem + 3.6vw, 4rem) / 1.05 var(--serif);
    font-optical-sizing: auto;
    letter-spacing: -0.017em;
  }
  .lead {
    max-width: 640px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }
  .facts {
    padding: 24px 0 40px;
    border-top: 1px solid var(--rule);
  }
  .facts dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 32px;
  }
  .facts dt {
    font: 400 21px/1.3 var(--serif);
    font-optical-sizing: auto;
  }
  .facts dd {
    margin: 6px 0 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 32px;
    font-size: 15px;
  }
  .how {
    padding-top: 40px;
    border-top: 1px solid var(--rule);
  }
  .how h2 {
    font: 400 clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem) / 1.15 var(--serif);
    font-optical-sizing: auto;
  }
  .how-intro {
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
  }
  .principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 48px;
    margin-top: 32px;
    padding: 0;
    list-style: none;
  }
  .principles li {
    padding: 24px 0;
    border-top: 1px solid var(--rule);
  }
  .principles h3 {
    margin-bottom: 8px;
    font: 400 21px/1.3 var(--serif);
    font-optical-sizing: auto;
  }
  .principles p {
    font-size: 16px;
    line-height: 1.6;
  }
  .principles .seen {
    margin-top: 8px;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .about-header {
      padding: 48px 0 32px;
    }
    .lead {
      font-size: 17px;
    }
    .facts dl,
    .principles {
      grid-template-columns: 1fr;
    }
  }
</style>
