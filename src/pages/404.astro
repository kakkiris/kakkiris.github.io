---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found, Kerem Akkiris" description="This page does not exist." notFound>
  <article class="wrap page">
    <h1>This page does not exist.</h1>
    <p><a class="text-link" href="/">Go to the home page</a></p>
  </article>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 24px;
    padding-top: 96px;
    padding-bottom: 160px;
  }
  h1 {
    font: 400 clamp(2.25rem, 1.4rem + 3.4vw, 3.5rem) / 1.08 var(--serif);
    font-optical-sizing: auto;
    letter-spacing: -0.015em;
  }
</style>
